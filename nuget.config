<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="axiom-local" value="artifacts\packages" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="axiom-local">
      <package pattern="Axiom.*" />
      <package pattern="Axiom.Cli" />
    </packageSource>
  </packageSourceMapping>
</configuration>
